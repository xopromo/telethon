# Telegram API credentials
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+your_phone_number

# AI Provider API Keys (all supported)
# Agent will try them in order: Mistral → Gemini → Cerebras
# At least one API key must be provided

# Mistral API (fast, recommended as primary)
# Get key: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key

# Google Gemini API (fallback #1)
# Get key: https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key

# Cerebras API (fallback #2)
# Get key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_api_key

# Bot settings
BOT_USERNAME=your_telegram_username
SESSION_NAME=telegram_session
